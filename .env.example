NODE_ENV=development
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://default:password@localhost:6379

TRUST_PROXY=false

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

DEFAULT_SOURCE_TIMEOUT_MS=10000
DEFAULT_SOURCE_RETRY_COUNT=2

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

LOCK_TTL_MS=15000
LOCK_WAIT_MS=2000
LOCK_POLL_MS=100
STALE_MULTIPLIER=3

BRIGHTDATA_CLI_BIN=bdata
SELF_HEALING_CLI_TIMEOUT_SEC=1800
SELF_HEALING_OUTPUT_DIR=output

# Bright Data DCA — optional overrides (otherwise reads brightdata-cli credentials.json)
# Windows default: %APPDATA%\brightdata-cli\credentials.json
# Linux/macOS default: ~/.config/brightdata-cli/credentials.json
BRIGHTDATA_CLI_CREDENTIALS_PATH=
BRIGHT_DATA_API_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHT_DATA_BASE_URL=https://api.brightdata.com

# Scraper Studio collector IDs (unified schema output)
REDBUS_COLLECTOR_ID=c_mt5kcpdj13nspwzrzd
MAKEMYTRIP_COLLECTOR_ID=c_mt5m1h3uvef2inukz
ABHIBUS_COLLECTOR_ID=c_mt494k6m154fl23cty

BRIGHT_DATA_POLL_INTERVAL_MS=5000
BRIGHT_DATA_MAX_POLL_ATTEMPTS=60
BRIGHT_DATA_SOURCE_TIMEOUT_MS=300000
SCRAPER_DEFAULT_LIMIT=10
ABHIBUS_RESULT_LIMIT=10
