# =============================================================================
# RouteX API — environment variables
# Copy to .env and fill in required values. Never commit .env.
# =============================================================================

# --- Server (required) ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true

# --- Redis (required) ---
REDIS_URL=redis://default:password@localhost:6379

# --- Bright Data (required for live searches) ---
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_BASE_URL=https://api.brightdata.com

# Active collector IDs: redbus, makemytrip, cleartrip
REDBUS_COLLECTOR_ID=c_mt5kcpdj13nspwzrzd
MAKEMYTRIP_COLLECTOR_ID=c_mt5m1h3uvef2inukz
CLEARTrip_COLLECTOR_ID=c_mt5mys6i27rezbm6py

# Scraper polling & timeouts
BRIGHT_DATA_POLL_INTERVAL_MS=5000
BRIGHT_DATA_MAX_POLL_ATTEMPTS=60
BRIGHT_DATA_SOURCE_TIMEOUT_MS=300000
SCRAPER_DEFAULT_LIMIT=20

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Resilience ---
DEFAULT_SOURCE_TIMEOUT_MS=10000
DEFAULT_SOURCE_RETRY_COUNT=1
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# --- Distributed locks ---
LOCK_TTL_MS=15000
LOCK_WAIT_MS=2000
LOCK_POLL_MS=100

# --- Provider cache (L1) + sessions (L2) ---
PROVIDER_CACHE_FRESH_MS=600000
PROVIDER_CACHE_STALE_MS=900000
PROVIDER_RETRY_COOLDOWN_MS=900000

# --- Self-healing (local dev only — not available in Docker) ---
BRIGHTDATA_CLI_BIN=bdata
SELF_HEALING_CLI_TIMEOUT_SEC=1800
SELF_HEALING_OUTPUT_DIR=output
